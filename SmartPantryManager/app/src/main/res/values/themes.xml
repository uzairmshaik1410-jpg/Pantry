<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =====================================================================
         App theme  (Material 3, light, "Herb & Cream")
         ===================================================================== -->
    <style name="Theme.SmartPantry" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
        <item name="colorOnPrimaryContainer">@color/green_dark</item>

        <!-- Secondary (drives the bottom-nav pill & selected toggle buttons) -->
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/green_container</item>
        <item name="colorOnSecondaryContainer">@color/green_dark</item>

        <!-- Tertiary (warm saffron accent) -->
        <item name="colorTertiary">@color/saffron</item>
        <item name="colorOnTertiary">@color/on_saffron</item>
        <item name="colorTertiaryContainer">@color/saffron_container</item>
        <item name="colorOnTertiaryContainer">@color/on_saffron</item>

        <!-- Error -->
        <item name="colorError">@color/red</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/red_container</item>
        <item name="colorOnErrorContainer">@color/red</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_dark</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/grey</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_soft</item>

        <!-- Window / system bars: cream status bar with dark icons -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/grey</item>
    </style>


    <!-- =====================================================================
         Text appearances
         ===================================================================== -->
    <style name="TextAppearance.SmartPantry.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/green_dark</item>
    </style>

    <style name="TextAppearance.SmartPantry.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <style name="TextAppearance.SmartPantry.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/green_dark</item>
    </style>

    <style name="TextAppearance.SmartPantry.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/green_primary</item>
    </style>

    <style name="TextAppearance.SmartPantry.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <style name="TextAppearance.SmartPantry.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <style name="TextAppearance.SmartPantry.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/grey</item>
    </style>

    <style name="TextAppearance.SmartPantry.Status" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <!-- =====================================================================
         Toolbar: flat, cream, bold dark-green title
         ===================================================================== -->
    <style name="Widget.SmartPantry.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/background</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.SmartPantry.ToolbarTitle</item>
        <item name="titleTextColor">@color/green_dark</item>
        <item name="navigationIconTint">@color/green_dark</item>
    </style>


    <!-- =====================================================================
         Cards: white, 18dp corners, hairline border, no shadow
         ===================================================================== -->
    <style name="Widget.SmartPantry.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>


    <!-- =====================================================================
         Buttons
         ===================================================================== -->
    <style name="Widget.SmartPantry.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.SmartPantry.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.SmartPantry.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/red</item>
        <item name="strokeColor">@color/red</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/red</item>
        <item name="rippleColor">@color/red_container</item>
    </style>

    <style name="Widget.SmartPantry.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <!-- =====================================================================
         Text fields: rounded outlined boxes
         ===================================================================== -->
    <style name="Widget.SmartPantry.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/green_primary</item>
        <item name="hintTextColor">@color/green_primary</item>
    </style>

    <style name="Widget.SmartPantry.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/green_primary</item>
        <item name="hintTextColor">@color/green_primary</item>
    </style>


    <!-- =====================================================================
         Floating action button: green rounded square
         ===================================================================== -->
    <style name="ShapeAppearanceOverlay.SmartPantry.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.SmartPantry.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/green_primary</item>
        <item name="tint">@color/white</item>
        <item name="rippleColor">@color/green_dark</item>
        <item name="elevation">4dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SmartPantry.Fab</item>
    </style>


    <!-- =====================================================================
         Bottom navigation: white bar, green pill on the active tab
         ===================================================================== -->
    <style name="Widget.SmartPantry.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/white</item>
        <item name="android:elevation">0dp</item>
    </style>

</resources>
